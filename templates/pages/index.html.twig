{% extends "base.html.twig" %}

{% block title %}{{ 'index.title'|trans }}{% endblock %}
{% set meta_description = 'index.description'|trans %}

{% block styles %}{{ encore_entry_link_tags('css/main') }}{% endblock %}

{% set body_class = 'body-grimoire' %}

{% block body %}

<h1 class="title">{{ 'title'|trans }}</h1>

{% include 'partials/setup.html.twig' %}
{% include 'partials/grimoire.html.twig' %}
{% include 'partials/jinxes.html.twig' %}
{% include 'partials/night-order.html.twig' %}
{% include 'partials/info-tokens.html.twig' %}
{% include 'partials/notes.html.twig' %}
{% include 'partials/acknowledgements.html.twig' %}
{% include 'partials/community.html.twig' %}

{% endblock %}

{% block javascript %}
{% set version = hash(4) %}
<script>
var URLS = {
    homebrew: "{{ path('homebrew')|e('js') }}",
    drawCreate: "{{ path('draw_create')|e('js') }}",
    url: "{{ path('data_url', { url: '{url}' })|e('js') }}",
    botc: "{{ path('data_get_botc', { term: '{term}' })|e('js') }}",
};

var I18N = {
    goodTeam: "{{ 'messages.good_team'|trans|e('js') }}",
    evilTeam: "{{ 'messages.evil_team'|trans|e('js') }}",
    emptyCharacterAbility: "{{ 'messages.empty_character_ability'|trans|e('js') }}",
    versionChange: "{{ 'messages.version_change_message'|trans|e('js') }}",
    invalidScript: "{{ 'messages.invalid_script'|trans|e('js') }}",
    noCharacters: "{{ 'messages.no_characters'|trans|e('js') }}",
    customInfoToken: "{{ 'messages.custom_info_token'|trans|e('js') }}",
    bagDisabled: "{{ 'messages.bag_disabled'|trans|e('js') }}",
    playerDrawWaiting: "{{ 'setup.player_draw.waiting'|trans|e('js') }}",
    playerDrawClaimed: "{{ 'setup.player_draw.claimed'|trans|e('js') }}",
    playerDrawTyping: "{{ 'setup.player_draw.typing'|trans|e('js') }}",
    playerDrawReady: "{{ 'setup.player_draw.ready'|trans|e('js') }}",
    playerDrawNoName: "{{ 'setup.player_draw.no_name'|trans|e('js') }}",
    playerDrawCreateError: "{{ 'setup.player_draw.create_error'|trans|e('js') }}",
    playerDrawCopyLink: "{{ 'setup.player_draw.copy_link'|trans|e('js') }}",
    playerDrawLinkCopied: "{{ 'setup.player_draw.link_copied'|trans|e('js') }}",
    playerDrawCopyError: "{{ 'setup.player_draw.copy_error'|trans|e('js') }}",
    players: "{{ 'groups.players'|trans|e('js') }}",
    townsfolk: "{{ 'groups.townsfolk'|trans|e('js') }}",
    outsider: "{{ 'groups.outsider'|trans|e('js') }}",
    minion: "{{ 'groups.minion'|trans|e('js') }}",
    demon: "{{ 'groups.demon'|trans|e('js') }}",
};

var ENVIRONMENT = "{{ app.environment|e('js') }}";
</script>
<script src="/build/data/{{ app.request.locale }}.js"></script>
{{ encore_entry_script_tags('js/main') }}
{% endblock %}
