<button type="button" class="button button--full-height" id="select-edition" data-dialog="#edition-list">{{ 'setup.buttons.select_edition'|trans }}</button>

{% embed 'includes/dialog.html.twig' with {
    id: 'edition-list',
    background: 'blur',
    title: 'setup.editions.title'|trans
} %}
    {% import 'macros/forms.html.twig' as forms %}
    {% block body %}

    <form id="select-edition-form" enctype="multipart/form-data">

        <details name="select-edition" class="edition-details" data-id="official" open>
            <summary class="edition-details__summary">Official scripts</summary>
            <div class="edition-details__body">
                <ul class="no-list">
                    <li>
                        {{ forms.radio({
                            name: 'edition',
                            value: 'tb',
                            label: 'setup.editions.trouble_brewing'|trans,
                            required: true
                        }) }}
                    </li>
                    <li>
                        {{ forms.radio({
                            name: 'edition',
                            value: 'bmr',
                            label: 'setup.editions.bad_moon_rising'|trans
                        }) }}
                    </li>
                    <li>
                        {{ forms.radio({
                            name: 'edition',
                            value: 'snv',
                            label: 'setup.editions.sects_and_violets'|trans
                        }) }}
                    </li>
                </ul>
            </div>
        </details>
        <details name="select-edition" class="edition-details" data-id="upload">
            <summary class="edition-details__summary">{{ 'setup.editions.upload'|trans }}</summary>
            <div class="edition-details__body">
                <label for="custom-script-upload" class="sr-only">{{ 'setup.editions.upload'|trans }}</label>
                {{ forms.file({
                    name: "custom-script-upload",
                    id: "custom-script-upload",
                    accept: "application/json",
                    required: true
                }) }}
            </div>
        </details>
        <details name="select-edition" class="edition-details" data-id="url">
            <summary class="edition-details__summary">{{ 'setup.editions.url'|trans }}</summary>
            <div class="edition-details__body">
                <label for="custom-script-url" class="sr-only">{{ 'setup.editions.url'|trans }}</label>
                <input type="url" name="custom-script-url" id="custom-script-url" class="input" placeholder="https://www.example.com/script.json" required data-no-store>
            </div>
        </details>
        <details name="select-edition" class="edition-details" data-id="paste">
            <summary class="edition-details__summary">{{ 'setup.editions.paste'|trans }}</summary>
            <div class="edition-details__body">
                <label for="custom-script-paste" class="sr-only">{{ 'setup.editions.paste'|trans }}</label>
                <textarea name="custom-script-paste" id="custom-script-paste" class="input" placeholder='["washerwoman","investigator","librarian","chef"]' required></textarea>
            </div>
        </details>
        <details name="select-edition" class="edition-details" data-id="botc">
            <summary class="edition-details__summary">BotC Scripts</summary>
            <div class="edition-details__body">
                <p>
                    <label for="botc-scripts">Look up script</label>
                    <input type="text" name="botc-scripts" id="botc-scripts" class="input" required data-no-store>
                </p>
                <div id="botc-scripts">
                    <span id="botc-scripts-loader" class="loader" aria-hidden="true" hidden></span>
                    <p id="botc-scripts-empty" hidden>No results could be found</p>
                    <ul id="botc-scripts-results" class="no-list edition-details__entries" hidden></ul>
                </div>
            </div>
        </details>

        <template id="botc-scripts-entry">
            <li>
                <label class="radio edition-details__radio js--botc-scripts--label">
                    <span class="radio__wrapper">
                        <input
                            type="radio"
                            name="botc-script"
                            class="radio__input js--botc-scripts--input"
                        >
                        <span class="radio__render"></span>
                    </span>
                    <span class="radio__label">
                        <strong class="edition-details__name js--botc-scripts--name"></strong>
                        <small class="edition-details__author js--botc-scripts--author"></small>
                    </span>
                </label>
            </li>
        </template>

        <p>
            <button type="submit" class="button">
                <span class="button__text">{{ 'setup.editions.select'|trans }}</span>
                <span class="button__loader" role="progressbar" aria-valuetext="Loading" aria-busy="false" aria-live="assertive" aria-valuemin="0" aria-valuemax="1">
                    <span class="loader" aria-hidden="true"></span>
                </span>
            </button>
        </p>

    </form>
    {% endblock %}
{% endembed %}
